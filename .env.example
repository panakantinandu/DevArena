# Copy to .env (never commit .env). See docs/environment.md for details.

# ---- Backend (Spring Boot) ----
# Local PostgreSQL. Production uses jdbc:postgresql://<host>/<db>?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/devarena
DATABASE_USERNAME=devarena
DATABASE_PASSWORD=change-me
# Comma-separated browser origins allowed to call the API and open WebSockets.
DEVARENA_CORS_ALLOWED_ORIGINS=http://localhost:5173
# true in production (HTTPS only cookies)
DEVARENA_SECURE_COOKIES=false
DB_POOL_MAX=5
PORT=8080

# ---- Frontend (Vite) — public values only, never secrets ----
# Leave empty to use same-origin /api (Vite proxy locally, Vercel rewrite in production).
VITE_API_BASE_URL=
# Production: wss://YOUR-RENDER-SERVICE.onrender.com   (leave empty locally)
VITE_WS_BASE_URL=
